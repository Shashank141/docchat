# Copy this file to .env and fill in your values

# Required: get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: only needed if you want persistent chat history in MongoDB.
# Leave blank to use in-memory history (fine for demos/interviews).
# Example: mongodb://localhost:27017 or your MongoDB Atlas connection string
MONGO_URI=

# Name of the database to use if MONGO_URI is set
MONGO_DB_NAME=docchat
